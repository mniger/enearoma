---
/** Layout di base: <head> SEO-ready, font self-hosted, header/footer. */
// Solo i pesi realmente usati: Cormorant 400 (titoli), Cinzel 400 (etichette),
// Jost 300 (testo) e 400 (evidenza) — e solo il subset latin: gli altri
// alfabeti non servono a un sito it/en e gonfiano l'upload.
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cinzel/latin-400.css';
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import cormorantUrl from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import cinzelUrl from '@fontsource/cinzel/files/cinzel-latin-400-normal.woff2?url';
import jost300Url from '@fontsource/jost/files/jost-latin-300-normal.woff2?url';
import jost400Url from '@fontsource/jost/files/jost-latin-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Reveal from '../components/Reveal.astro';
import { ClientRouter } from 'astro:transitions';
import { brand, contatti, legale, piattaforme, prenotazioni, traduzioni, type Locale } from '../data/site';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const locale = (Astro.currentLocale ?? 'it') as Locale;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-enea.jpg', Astro.site);
const salta = locale === 'en' ? 'Skip to content' : 'Vai al contenuto';
// Solo le pagine tradotte dichiarano gli hreflang.
const coppia = traduzioni.find(([it, en]) => it === Astro.url.pathname || en === Astro.url.pathname);
const ogImageAlt = locale === 'en'
  ? 'The ENEA Roma mark: golden stone pine and wordmark on a dark ground'
  : 'Il marchio ENEA Roma: pino dorato e scritta su fondo scuro';

const datiStrutturati = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: brand.nomeEsteso,
  legalName: legale.ragioneSociale,
  vatID: legale.partitaIva,
  servesCuisine: locale === 'en' ? ['Mediterranean', 'Italian'] : ['Mediterranea', 'Italiana'],
  url: canonical.href,
  image: ogImage.href,
  telephone: contatti.telefono,
  acceptsReservations: prenotazioni.aperte,
  hasMap: contatti.mapsUrl,
  hasMenu: new URL('/menu/', Astro.site).href,
  sameAs: [piattaforme.instagram, piattaforme.tripadvisor, piattaforme.opentable],
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${contatti.via} ${contatti.civico}`,
    postalCode: contatti.cap,
    addressLocality: contatti.citta,
    addressCountry: 'IT',
  },
  // Alla conferma del cliente: openingHoursSpecification, priceRange.
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}

    <!-- i font si scoprono solo dopo il parse del CSS: senza preload il testo
         appare in fallback e poi scatta -->
    <link rel="preload" as="font" type="font/woff2" href={cormorantUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={cinzelUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jost300Url} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jost400Url} crossorigin />

    <meta property="og:site_name" content={brand.nomeEsteso} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={locale === 'en' ? 'en_GB' : 'it_IT'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'it_IT' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    {noindex && <meta name="robots" content="noindex" />}
    {/* gli hreflang valgono solo per le pagine che esistono in entrambe le lingue */}
    {!noindex && coppia && (
      <>
        <link rel="alternate" hreflang="it" href={new URL(coppia[0], Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(coppia[1], Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(coppia[0], Astro.site)} />
      </>
    )}
    <slot name="head" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A0806" />
    <!--
      Dati strutturati schema.org/Restaurant.
      Emessi SOLO per i campi confermati: finché indirizzo, telefono e orari non
      sono validati dal cliente restano fuori, perché dati errati nei rich result
      fanno più danno che non averli.
    -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(datiStrutturati)} />
    <ClientRouter />
    <Reveal />
  </head>
  <body>
    <a class="salta" href="#contenuto">{salta}</a>
    <Header />
    <main id="contenuto" tabindex="-1"><slot /></main>
    <script>
      // Chi arriva con un'ancora (es. #prenota) trova il focus sul bersaglio, così
      // lo screen reader legge subito il blocco; dopo una navigazione con
      // transizione il focus riparte dal contenuto, come a un caricamento pieno.
      const alBersaglio = () => {
        const id = decodeURIComponent(location.hash.slice(1));
        const el = id ? document.getElementById(id) : null;
        if (el?.hasAttribute('tabindex')) el.focus({ preventScroll: true });
      };
      document.addEventListener('astro:after-swap', () => document.getElementById('contenuto')?.focus({ preventScroll: true }));
      document.addEventListener('astro:page-load', alBersaglio);
      addEventListener('hashchange', alBersaglio);
    </script>
    <Footer />
  </body>
</html>

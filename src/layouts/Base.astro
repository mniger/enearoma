---
/** Layout di base: <head> SEO-ready, font self-hosted, header/footer. */
// Solo i pesi realmente usati: Cormorant 400 (titoli), Cinzel 400 (etichette),
// Jost 300 (testo) e 400 (evidenza). Ogni peso in più è banda sprecata.
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cinzel/400.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Reveal from '../components/Reveal.astro';
import { ClientRouter } from 'astro:transitions';
import { brand, contatti, legale, type Locale } from '../data/site';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const locale = (Astro.currentLocale ?? 'it') as Locale;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-enea.jpg', Astro.site);
const salta = locale === 'en' ? 'Skip to content' : 'Vai al contenuto';

const datiStrutturati = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: brand.nomeEsteso,
  legalName: legale.ragioneSociale,
  vatID: legale.partitaIva,
  servesCuisine: ['Mediterranea', 'Italiana'],
  url: Astro.site?.href,
  image: ogImage.href,
  inLanguage: locale,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${contatti.via} ${contatti.civico}`,
    postalCode: contatti.cap,
    addressLocality: contatti.citta,
    addressCountry: 'IT',
  },
  // TODO alla conferma del cliente: telephone, openingHoursSpecification,
  // priceRange, hasMenu, acceptsReservations, sameAs (Instagram/Google).
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={brand.nomeEsteso} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={brand.nomeEsteso} />
    <meta property="og:locale" content={locale === 'en' ? 'en_GB' : 'it_IT'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'it_IT' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" hreflang="it" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A0806" />
    <!--
      Dati strutturati schema.org/Restaurant.
      Emessi SOLO per i campi confermati: finché indirizzo, telefono e orari non
      sono validati dal cliente restano fuori, perché dati errati nei rich result
      fanno più danno che non averli.
    -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(datiStrutturati)} />
    <ClientRouter />
    <Reveal />
  </head>
  <body>
    <a class="salta" href="#contenuto">{salta}</a>
    <Header />
    <main id="contenuto"><slot /></main>
    <Footer />
  </body>
</html>

---
/** Layout di base: <head> SEO-ready, font self-hosted, header/footer. */
// Solo i pesi realmente usati: Cormorant 400 (titoli), Cinzel 400 (etichette),
// Jost 300 (testo) e 400 (evidenza) — e solo il subset latin: gli altri
// alfabeti non servono a un sito it/en e gonfiano l'upload.
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cinzel/latin-400.css';
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import cormorantUrl from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import cinzelUrl from '@fontsource/cinzel/files/cinzel-latin-400-normal.woff2?url';
import jost300Url from '@fontsource/jost/files/jost-latin-300-normal.woff2?url';
import jost400Url from '@fontsource/jost/files/jost-latin-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Reveal from '../components/Reveal.astro';
import { ClientRouter } from 'astro:transitions';
import { brand, contatti, dataApertura, legale, nav, orari, piattaforme, prenotazioni, traduzioni, type Locale } from '../data/site';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const locale = (Astro.currentLocale ?? 'it') as Locale;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-enea.jpg', Astro.site);
const salta = locale === 'en' ? 'Skip to content' : 'Vai al contenuto';
// Solo le pagine tradotte dichiarano gli hreflang.
const coppia = traduzioni.find(([it, en]) => it === Astro.url.pathname || en === Astro.url.pathname);
const ogImageAlt = locale === 'en'
  ? 'The ENEA Roma mark: golden stone pine and wordmark on a dark ground'
  : 'Il marchio ENEA Roma: pino dorato e scritta su fondo scuro';

// I quattro menu nella lingua della pagina: ognuno dichiara il suo Menu con @id = url#menu.
const menuDelSito = nav[locale].flatMap((v) => v.sotto ?? [])
  .map((s) => new URL((locale === 'en' ? '/en' : '') + s.href, Astro.site).href);

const datiStrutturati = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  // lo stesso ristorante su tutte le pagine e in tutte e due le lingue
  '@id': new URL('/#ristorante', Astro.site).href,
  name: brand.nomeEsteso,
  legalName: legale.ragioneSociale,
  vatID: `IT${legale.partitaIva}`,
  servesCuisine: locale === 'en' ? ['Mediterranean', 'Italian'] : ['Mediterranea', 'Italiana'],
  url: new URL(locale === 'en' ? '/en/' : '/', Astro.site).href,
  image: ogImage.href,
  telephone: contatti.telefono,
  acceptsReservations: prenotazioni.aperte,
  hasMap: contatti.mapsUrl,
  hasMenu: menuDelSito.map((u) => ({ '@type': 'Menu', '@id': `${u}#menu`, url: u })),
  sameAs: [piattaforme.instagram, piattaforme.tripadvisor, piattaforme.opentable],
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${contatti.via} ${contatti.civico}`,
    postalCode: contatti.cap,
    addressLocality: contatti.citta,
    addressCountry: 'IT',
  },
  geo: { '@type': 'GeoCoordinates', latitude: contatti.geo.lat, longitude: contatti.geo.lon },
  // gli orari solo con la data di apertura: prima risulterebbe «aperto» un locale ancora chiuso
  ...(dataApertura && {
    openingHoursSpecification: orari.cucina.map((f) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: f.apre,
      closes: f.chiude,
      validFrom: dataApertura,
    })),
  }),
  // Alla conferma del cliente: priceRange.
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <!-- GitHub Pages non può forzare l'HTTPS finché il certificato di www è bloccato:
         chi arriva in http (per esempio dal link «sito web» di Google, che è http://www)
         passa qui all'https dell'apex, che ha il certificato valido -->
    <script is:inline>if (location.protocol === 'http:' && /^(www\.)?enearoma\.it$/.test(location.hostname)) location.replace('https://enearoma.it' + location.pathname + location.search + location.hash);</script>
    {/* Chi arriva dal QR del tavolo (?qr) legge il menu nella lingua del telefono: italiano se il
        telefono è in italiano, inglese in tutti gli altri casi. Solo col parametro: chi arriva da
        Google o da un link resta dov'è, e Googlebot (che si presenta in inglese) non viene spostato. */}
    {locale === 'it' && coppia && Astro.url.pathname.startsWith('/menu/') && (
      <script is:inline define:vars={{ inglese: coppia[1] }}>
        if (new URLSearchParams(location.search).has('qr')) {
          var lingua = (navigator.languages && navigator.languages[0]) || navigator.language || '';
          if (!/^it\b/i.test(lingua)) location.replace(inglese + location.hash);
          else history.replaceState(null, '', location.pathname + location.hash);
        }
      </script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}

    <!-- i font si scoprono solo dopo il parse del CSS: senza preload il testo
         appare in fallback e poi scatta -->
    <link rel="preload" as="font" type="font/woff2" href={cormorantUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={cinzelUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jost300Url} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jost400Url} crossorigin />

    <meta property="og:site_name" content={brand.nomeEsteso} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={locale === 'en' ? 'en_GB' : 'it_IT'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'it_IT' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    {noindex && <meta name="robots" content="noindex" />}
    {/* gli hreflang valgono solo per le pagine che esistono in entrambe le lingue */}
    {!noindex && coppia && (
      <>
        <link rel="alternate" hreflang="it" href={new URL(coppia[0], Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(coppia[1], Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(coppia[0], Astro.site)} />
      </>
    )}
    <slot name="head" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A0806" />
    <!--
      Dati strutturati schema.org/Restaurant: solo dati confermati dal titolare
      (gli orari entrano con dataApertura). Dati errati nei rich result fanno
      più danno che non averli. Le pagine noindex (la 404) non li emettono.
    -->
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(datiStrutturati)} />}
    <ClientRouter />
    <Reveal />
  </head>
  <body>
    <a class="salta" href="#contenuto">{salta}</a>
    <Header />
    <main id="contenuto" tabindex="-1"><slot /></main>
    <script>
      // Chi arriva con un'ancora (es. #prenota) trova il focus sul bersaglio, così
      // lo screen reader legge subito il blocco; dopo una navigazione con
      // transizione il focus riparte dal contenuto, come a un caricamento pieno.
      const alBersaglio = () => {
        const id = decodeURIComponent(location.hash.slice(1));
        const el = id ? document.getElementById(id) : null;
        if (el?.hasAttribute('tabindex')) el.focus({ preventScroll: true });
      };
      document.addEventListener('astro:after-swap', () => document.getElementById('contenuto')?.focus({ preventScroll: true }));
      document.addEventListener('astro:page-load', alBersaglio);
      addEventListener('hashchange', alBersaglio);
    </script>
    <Footer />
  </body>
</html>

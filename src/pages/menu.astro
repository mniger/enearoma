---
import Base from '../layouts/Base.astro';
import MenuContent from '../components/MenuContent.astro';
import { menuCena } from '../data/menu';
import { brand } from '../data/site';

// Dati strutturati schema.org/Menu: Google legge sezioni, piatti e prezzi.
const datiMenu = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Menu della cena — ${menuCena.stagione.it}`,
  inLanguage: 'it',
  url: new URL('/menu/', Astro.site).href,
  hasMenuSection: menuCena.sezioni.map((s) => ({
    '@type': 'MenuSection',
    name: s.titolo.it,
    hasMenuItem: s.piatti.map((p) => ({
      '@type': 'MenuItem',
      name: p.nome.it,
      offers: { '@type': 'Offer', price: String(p.prezzo), priceCurrency: 'EUR' },
    })),
  })),
};
---
<Base
  title={`Menu della cena — ${brand.nomeEsteso}`}
  description="Il menu della cena di ENEA Roma, autunno 2026: antipasti, primi, secondi e dolci con prezzi e allergeni. Cucina mediterranea in Via Boncompagni, a due passi da Via Veneto."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(datiMenu)} />
  </Fragment>
  <MenuContent />
</Base>

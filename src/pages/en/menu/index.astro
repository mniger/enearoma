---
import Base from '../../../layouts/Base.astro';
import MenuContent from '../../../components/MenuContent.astro';
import { menuCena, datiStrutturatiMenu } from '../../../data/menu';
import { brand } from '../../../data/site';

const url = new URL(Astro.url.pathname, Astro.site).href;
---
<Base title={`Dinner menu — ${brand.nomeEsteso}`} description="ENEA Roma’s dinner menu for autumn 2026: starters, first courses, mains and desserts with prices and allergens. Mediterranean cooking on Via Boncompagni, steps from Via Veneto.">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(datiStrutturatiMenu(menuCena, 'en', url))} />
  </Fragment>
  <MenuContent menu={menuCena} variante="cena" />
</Base>

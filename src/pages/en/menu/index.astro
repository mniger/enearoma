---
import Base from '../../../layouts/Base.astro';
import MenuContent from '../../../components/MenuContent.astro';
import { menuCarta, datiStrutturatiMenu } from '../../../data/menu';
import { brand } from '../../../data/site';

const url = new URL(Astro.url.pathname, Astro.site).href;
---
<Base title={`À la carte menu — ${brand.nomeEsteso}`} description="ENEA Roma’s à la carte menu for lunch and dinner, autumn 2026: starters, first courses, mains and desserts with prices and allergens. Mediterranean cooking on Via Boncompagni, steps from Via Veneto.">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(datiStrutturatiMenu(menuCarta, 'en', url))} />
  </Fragment>
  <MenuContent menu={menuCarta} variante="carta" />
</Base>

---
import Base from '../../layouts/Base.astro';
import MenuContent from '../../components/MenuContent.astro';
import { menuAperitivo, datiStrutturatiMenu } from '../../data/menu';
import { brand } from '../../data/site';

const url = new URL(Astro.url.pathname, Astro.site).href;
---
<Base title={`Menu dell’aperitivo — ${brand.nomeEsteso}`} description="L’aperitivo di ENEA Roma: piccoli piatti con prezzi e allergeni, in Via Boncompagni a due passi da Via Veneto.">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(datiStrutturatiMenu(menuAperitivo, 'it', url))} />
  </Fragment>
  <MenuContent menu={menuAperitivo} variante="aperitivo" />
</Base>

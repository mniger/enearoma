---
import Base from '../../layouts/Base.astro';
import MenuContent from '../../components/MenuContent.astro';
import { menuCena, datiStrutturatiMenu } from '../../data/menu';
import { brand } from '../../data/site';

const url = new URL(Astro.url.pathname, Astro.site).href;
---
<Base title={`Menu della cena — ${brand.nomeEsteso}`} description="Il menu della cena di ENEA Roma, autunno 2026: antipasti, primi, secondi e dolci con prezzi e allergeni. Cucina mediterranea in Via Boncompagni, a due passi da Via Veneto.">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(datiStrutturatiMenu(menuCena, 'it', url))} />
  </Fragment>
  <MenuContent menu={menuCena} variante="cena" />
</Base>

---
import Base from '../../layouts/Base.astro';
import MenuContent from '../../components/MenuContent.astro';
import { menuPranzo, datiStrutturatiMenu } from '../../data/menu';
import { brand } from '../../data/site';

const url = new URL(Astro.url.pathname, Astro.site).href;
---
<Base title={`Business lunch — ${brand.nomeEsteso}`} description="Il business lunch di ENEA Roma: antipasto, primo o secondo del giorno a prezzo fisso, con acqua, pane e caffè compresi. In Via Boncompagni, a due passi da Via Veneto.">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(datiStrutturatiMenu(menuPranzo, 'it', url))} />
  </Fragment>
  <MenuContent menu={menuPranzo} variante="pranzo" />
</Base>

---
import Wordmark from './Wordmark.astro';
import MenuMobile from './MenuMobile.astro';
import { altraLingua, brand, nav, prenotazioni, type Locale } from '../data/site';
const locale = (Astro.currentLocale ?? 'it') as Locale;
const voci = nav[locale];
const base = locale === 'en' ? '/en' : '';
const altLang = { code: locale === 'en' ? 'IT' : 'EN', href: altraLingua(Astro.url.pathname, locale) };
// Finché le prenotazioni non aprono il pulsante promette un'informazione, non un'azione.
const corrente = (href: string) => !href.startsWith('/#') && Astro.url.pathname === base + href;
const apriTendina = locale === 'en' ? 'Show the menus' : 'Mostra i menu';
const prenota = prenotazioni.aperte
  ? (locale === 'en' ? 'Book' : 'Prenota')
  : (locale === 'en' ? 'Bookings' : 'Prenotazioni');
---
<header class="testata" id="testata" data-scrollato="no" data-tenda="no">
  <a class="testata__marchio" href={base + '/'} aria-label={brand.nomeEsteso}><Wordmark /></a>

  <nav class="testata__nav" aria-label={locale === 'en' ? 'Main navigation' : 'Navigazione principale'}>
    {voci.map((v) => v.sotto ? (
      <div class="gruppo" data-aperto="no">
        <a href={base + v.href} aria-current={Astro.url.pathname.startsWith(base + v.href) ? 'page' : undefined}>{v.label}</a>
        <button class="gruppo__apri" type="button" aria-expanded="false" aria-controls={`tendina-${v.href.replace(/\W/g, '')}`} aria-label={apriTendina}>
          <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true" focusable="false"><path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1"/></svg>
        </button>
        <ul class="tendina" id={`tendina-${v.href.replace(/\W/g, '')}`}>
          {v.sotto.map((s) => <li><a href={base + s.href} aria-current={corrente(s.href) ? 'page' : undefined}>{s.label}</a></li>)}
        </ul>
      </div>
    ) : (
      <a href={base + v.href} data-ancora={v.href.startsWith('/#') ? v.href.slice(2) : undefined}>{v.label}</a>
    ))}
  </nav>

  <div class="testata__coda">
    <a class="lingua" href={altLang.href} hreflang={altLang.code.toLowerCase()} lang={altLang.code.toLowerCase()} aria-label={altLang.code === 'EN' ? 'English' : 'Italiano'}>{altLang.code}</a>
    <a class="btn--mini" href={base + '/#prenota'}>{prenota}</a>
    <MenuMobile />
  </div>
</header>

<script>
  let staccaScroll: (() => void) | null = null;
  let staccaTendina: (() => void) | null = null;
  let spia: IntersectionObserver | null = null;

  function avvia() {
    staccaScroll?.();
    staccaTendina?.();
    spia?.disconnect();
    const testata = document.getElementById('testata');
    if (!testata) return;

    // Tendina dei menu: al mouse si apre da sola (CSS); il pulsante serve al
    // tocco e alla tastiera, Escape e il click fuori la chiudono.
    const gruppi = [...testata.querySelectorAll<HTMLElement>('.gruppo')];
    const imposta = (g: HTMLElement, aperto: boolean) => {
      g.dataset.aperto = aperto ? 'si' : 'no';
      g.querySelector('.gruppo__apri')?.setAttribute('aria-expanded', String(aperto));
    };
    const alClick = (e: Event) => {
      const tasto = (e.target as HTMLElement).closest('.gruppo__apri');
      const g = tasto?.closest<HTMLElement>('.gruppo');
      if (g) { imposta(g, g.dataset.aperto !== 'si'); return; }
      gruppi.forEach((x) => { if (!x.contains(e.target as Node)) imposta(x, false); });
    };
    const allaFuga = (e: KeyboardEvent) => {
      if (e.key !== 'Escape') return;
      gruppi.forEach((g) => {
        if (g.dataset.aperto === 'si' || g.contains(document.activeElement)) {
          imposta(g, false); g.querySelector<HTMLElement>('.gruppo__apri')?.focus();
        }
      });
    };
    const alFocusOut = (e: FocusEvent) => {
      const g = (e.target as HTMLElement).closest<HTMLElement>('.gruppo');
      if (g && !g.contains(e.relatedTarget as Node)) imposta(g, false);
    };
    document.addEventListener('click', alClick);
    addEventListener('keydown', allaFuga);
    testata.addEventListener('focusout', alFocusOut);
    staccaTendina = () => {
      document.removeEventListener('click', alClick);
      removeEventListener('keydown', allaFuga);
      testata.removeEventListener('focusout', alFocusOut);
    };

    let atteso = false;
    const aggiorna = () => {
      testata.dataset.scrollato = scrollY > 48 ? 'si' : 'no';
      atteso = false;
    };
    const alloScroll = () => { if (!atteso) { atteso = true; requestAnimationFrame(aggiorna); } };
    addEventListener('scroll', alloScroll, { passive: true });
    staccaScroll = () => removeEventListener('scroll', alloScroll);
    aggiorna();

    // La voce di menu segue la sezione in lettura. Si tiene l’ultima sezione
    // entrata nella fascia alta del viewport, non la più visibile: con sezioni
    // di altezza molto diversa quella regola sfarfalla.
    const link = new Map<string, Element>();
    testata.querySelectorAll<HTMLAnchorElement>('.testata__nav a[data-ancora]')
      .forEach((a) => link.set(a.dataset.ancora!, a));
    const sezioni = [...link.keys()]
      .map((id) => document.getElementById(id))
      .filter((e): e is HTMLElement => e !== null);
    if (!sezioni.length) return;

    const inVista = new Set<string>();
    spia = new IntersectionObserver((voci) => {
      voci.forEach((v) => { if (v.isIntersecting) inVista.add(v.target.id); else inVista.delete(v.target.id); });
      const corrente = [...inVista].at(-1) ?? null;
      link.forEach((a, id) => {
        const attivo = id === corrente;
        a.toggleAttribute('data-qui', attivo);
        if (attivo) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    }, { rootMargin: '-18% 0px -70% 0px' });
    sezioni.forEach((sez) => spia!.observe(sez));
  }

  document.addEventListener('astro:page-load', avvia);
</script>

<style>
  .testata {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    display: flex; align-items: center; gap: 1.5rem;
    padding: 1rem var(--gutter);
    background: linear-gradient(to bottom, rgba(10,8,6,.72), transparent);
    transition: background .5s var(--ease), padding .5s var(--ease), border-color .5s var(--ease);
    border-bottom: 1px solid transparent;
  }
  /* dopo lo scroll la testata si posa: fondo pieno, filo d’oro, meno respiro */
  .testata[data-scrollato='si'] {
    background: rgba(10, 8, 6, .9);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    border-bottom-color: var(--bordo);
    padding-block: .65rem;
  }
  .testata__marchio {
    position: relative; z-index: 3; text-decoration: none; margin-right: auto;
    --wordmark-larghezza: 132px; color: var(--oro-chiaro);
    display: flex; align-items: center; min-height: 44px;   /* bersaglio pieno */
    transition: color .4s var(--ease);
  }
  .testata__marchio:hover { color: var(--oro-luce); }
  /* sull'apertura della home il lockup grande è già in scena: il marchio in
     barra compare quando la pagina scorre */
  :global(body:has(.apertura)) .testata[data-scrollato='no'][data-tenda='no'] .testata__marchio {
    opacity: 0; visibility: hidden; transition: opacity .4s var(--ease), visibility 0s .4s;
  }
  .testata[data-scrollato="si"] .testata__marchio { --wordmark-larghezza: 118px; }
  .testata__nav { display: none; gap: clamp(1rem, 2vw, 2.1rem); }
  .testata__nav a {
    position: relative;
    font-family: var(--font-lapide); font-size: var(--fs-xs); letter-spacing: .2em;
    text-transform: uppercase; text-decoration: none; color: var(--travertino); white-space: nowrap;
    display: inline-flex; align-items: center; min-height: 44px;
  }
  /* filo d’oro che si apre da sinistra */
  .testata__nav a::after {
    content: ''; position: absolute; left: 0; bottom: 9px; height: 1px; width: 100%;
    background: var(--oro); transform: scaleX(0); transform-origin: left;
    transition: transform .45s var(--ease);
  }
  .testata__nav a:hover::after, .testata__nav a:focus-visible::after { transform: scaleX(1); }
  .testata__nav a[data-qui], .testata__nav a[aria-current='page'] { color: var(--oro-chiaro); }
  .testata__nav a[data-qui]::after, .testata__nav a[aria-current='page']::after { transform: scaleX(1); }

  /* ── tendina dei menu ── */
  .gruppo { position: relative; display: inline-flex; align-items: center; gap: .3rem; }
  .gruppo__apri {
    display: inline-grid; place-items: center; width: 28px; height: 44px;
    padding: 0; background: none; border: 0; color: var(--fumo); cursor: pointer;
    transition: color .3s ease, transform .3s var(--ease);
  }
  .gruppo__apri:hover, .gruppo:hover .gruppo__apri { color: var(--oro-chiaro); }
  .gruppo[data-aperto='si'] .gruppo__apri svg { transform: rotate(180deg); }
  .tendina {
    position: absolute; top: calc(100% - 4px); left: -1.25rem; min-width: 12rem;
    margin: 0; padding: .6rem 0; list-style: none;
    background: rgba(10, 8, 6, .96); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    border: 1px solid var(--bordo); border-top-color: var(--oro);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity .3s var(--ease), transform .3s var(--ease), visibility 0s .3s;
  }
  .gruppo:hover .tendina, .gruppo:focus-within .tendina, .gruppo[data-aperto='si'] .tendina {
    opacity: 1; visibility: visible; transform: none; transition-delay: 0s;
  }
  .tendina a {
    display: flex; min-height: 44px; padding: 0 1.25rem; white-space: nowrap;
  }
  .tendina a::after { left: 1.25rem; right: 1.25rem; width: auto; }
  .tendina a[aria-current='page'] { color: var(--oro-chiaro); }
  @media (prefers-reduced-motion: reduce) { .tendina, .gruppo__apri svg { transition: none; } }

  .testata__coda { position: relative; z-index: 2; display: flex; align-items: center; gap: 1rem; margin-left: clamp(.5rem, 2vw, 2rem); }
  .lingua {
    font-family: var(--font-lapide); font-size: var(--fs-xs); letter-spacing: .12em;
    color: var(--fumo); text-decoration: none; padding: .9rem .3rem;
    display: inline-flex; justify-content: center; min-width: 44px;
    transition: color .3s ease;
  }
  .lingua:hover { color: var(--oro-chiaro); }
  .btn--mini {
    font-family: var(--font-lapide); font-size: var(--fs-xs); letter-spacing: .22em; text-transform: uppercase;
    text-decoration: none; padding: .8rem 1.15rem; border: 1px solid var(--oro); color: var(--oro-chiaro);
    white-space: nowrap;
    transition: background-color .4s var(--ease), color .4s var(--ease);
  }
  .btn--mini:hover { background: var(--oro); color: var(--pece); }

  /* a tenda aperta il CTA vive dentro la tenda: in barra sarebbe un doppione */
  .testata[data-tenda='si'] .btn--mini,
  .testata[data-tenda='si'] .lingua { opacity: 0; pointer-events: none; transition: opacity .2s ease; }

  /* la barra stretta ospita marchio, prenotazione e menu: il marchio cede spazio */
  @media (max-width: 34rem) {
    .testata { gap: .75rem; }
    .testata__marchio { --wordmark-larghezza: 100px; }
    .testata[data-scrollato="si"] .testata__marchio { --wordmark-larghezza: 92px; }
    .btn--mini { font-size: .625rem; padding: .75rem .85rem; letter-spacing: .16em; }
  }
  @media (min-width: 62rem) { .testata__nav { display: flex; } }
</style>

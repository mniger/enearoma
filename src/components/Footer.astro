---
import Marchio from './Marchio.astro';
import { brand, contatti, legale, nav, type Locale } from '../data/site';
const locale = (Astro.currentLocale ?? 'it') as Locale;
const base = locale === 'en' ? '/en' : '';
const voci = nav[locale];
const altLang = locale === 'en'
  ? { code: 'Italiano', href: '/', lang: 'it' }
  : { code: 'English', href: '/en/', lang: 'en' };
const t = locale === 'en'
  ? { attesa: 'Site in progress — some details still to come', iva: 'VAT no.', note: 'Legal notes' }
  : { attesa: 'Sito in lavorazione — alcuni dati sono in arrivo', iva: 'P. IVA', note: 'Note legali' };
const citta = locale === 'en' ? 'Rome' : contatti.citta;
const indirizzo = `${contatti.via} ${contatti.civico}, ${contatti.cap} ${citta}`;
const anno = 2026;
---
<footer class="piede">
  <div class="wrap piede__griglia">
    <a class="piede__marchio" href={locale === 'en' ? '/en/' : '/'} aria-label={brand.nomeEsteso}><Marchio /></a>
    <p class="piede__dir">{indirizzo}</p>
    <nav class="piede__nav" aria-label={locale === 'en' ? 'Footer' : 'Piè di pagina'}>
      {voci.map((v) => <a href={base + '/' + v.href}>{v.label}</a>)}
      <a href={altLang.href} hreflang={altLang.lang} lang={altLang.lang}>{altLang.code}</a>
      <a href="/note-legali/" lang="it">{t.note}</a>
    </nav>
    <p class="piede__nota">© {anno} {legale.ragioneSociale} · {t.iva} {legale.partitaIva} · {t.attesa}</p>
  </div>
</footer>

<style>
  .piede { border-top: 1px solid var(--bordo); background: var(--notte); padding-block: clamp(2.5rem, 5vw, 4rem); }
  .piede__griglia { display: grid; gap: 1rem; justify-items: center; text-align: center; }
  .piede__marchio { text-decoration: none; --marchio-larghezza: 128px; color: var(--oro-chiaro); }
  .piede__dir { font-family: var(--font-lapide); font-size: var(--fs-xs); letter-spacing: .24em; text-transform: uppercase; color: var(--fumo); }
  .piede__nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .1rem 1.25rem; margin-top: .25rem; }
  .piede__nav a {
    font-family: var(--font-lapide); font-size: var(--fs-xs); letter-spacing: .18em;
    text-transform: uppercase; color: var(--fumo); text-decoration: none;
    padding: .85rem .25rem;                /* area di tocco ≥44px: il testo da solo è alto 19 px */
    transition: color .3s ease;
  }
  .piede__nav a:hover { color: var(--oro-chiaro); }
  .piede__nota { font-size: var(--fs-sm); color: var(--fumo); margin-top: .5rem; }
</style>

---
/**
 * L'anteprima della posizione in «Dove siamo».
 *
 * Non è un iframe di Google Maps: quello porta cookie di terzi (servirebbe il
 * banner, e le note legali dichiarano che il sito non ne usa). È la mappa di
 * OpenStreetMap disegnata nei colori del sito (scripts/genera-mappa.py) e un
 * tocco apre la scheda vera in Google Maps, dove ci sono indicazioni e
 * recensioni. Due disegni: 3:2 da tablet in su, 4:5 sul telefono. Il disegno
 * scala, nomi e segni no (sono in pixel): restano leggibili a ogni larghezza, e
 * i dettagli secondari compaiono solo quando il riquadro è abbastanza largo
 * (container query «mappa», regole scritte dallo script dentro gli SVG).
 * Accanto, la legenda con gli stessi segni: Via Veneto, metro, bus.
 */
import mappaLarga from '../assets/mappa-dove.svg?raw';
import mappaTelefono from '../assets/mappa-dove-telefono.svg?raw';
import { contatti, type Locale } from '../data/site';
import Freccia from './Freccia.astro';

const locale = (Astro.currentLocale ?? 'it') as Locale;
// tempi a piedi da ENEA: Google Maps, 05/10/2026 (gli stessi minuti sono nello script della mappa);
// linee: GTFS di Roma Servizi per la Mobilità del 05/10/2026 (63 e 83 vengono dal centro e
// fermano a Boncompagni/Piemonte; 92, 223, 360 e 910 legano Termini alle fermate qui intorno)
const L = locale === 'en'
  ? {
      apri: 'Open in Google Maps', nuovaScheda: 'opens in a new tab', dati: 'Map data', arrivare: 'Getting here',
      tappe: [
        ['via', 'Via Veneto', 'a 7-minute walk, at the end of Via Boncompagni'],
        ['metro', 'Metro line A', 'Barberini 13 minutes on foot, Repubblica 14'],
        ['bus', 'Bus', '63 and 83 from Piazza Venezia and the Trevi Fountain, Boncompagni/Piemonte stop 3 minutes away; from Termini, 92, 223, 360 and 910'],
      ],
    }
  : {
      apri: 'Apri in Google Maps', nuovaScheda: 'si apre in una nuova scheda', dati: 'Dati della mappa', arrivare: 'Come arrivare',
      tappe: [
        ['via', 'Via Veneto', 'a 7 minuti a piedi, in fondo a Via Boncompagni'],
        ['metro', 'Metro A', 'Barberini a 13 minuti a piedi, Repubblica a 14'],
        ['bus', 'Bus', '63 e 83 da Piazza Venezia e Fontana di Trevi, fermata Boncompagni/Piemonte a 3 minuti; da Termini 92, 223, 360 e 910'],
      ],
    };
---
<figure class="mappa" data-reveal>
  <a class="mappa__quadro" href={contatti.mapsUrl} target="_blank" rel="noopener" aria-label={`${L.apri} (${L.nuovaScheda})`}>
    <Fragment set:html={mappaLarga} />
    <Fragment set:html={mappaTelefono} />
  </a>
  <figcaption class="mappa__piede">
    <p class="eyebrow">{L.arrivare}</p>
    <ul class="mappa__tappe">
      {L.tappe.map(([segno, dove, come]) => (
        <li>
          {/* gli stessi segni della mappa */}
          <svg class={`mappa__segno mappa__segno--${segno}`} viewBox="-9 -9 18 18" aria-hidden="true" focusable="false">
            {segno === 'via' && <path d="M-8 4 L8 -4" />}
            {segno === 'metro' && <><rect x="-9" y="-9" width="18" height="18" rx="3.5" /><text text-anchor="middle" dy=".35em">M</text></>}
            {segno === 'bus' && <><rect x="-8" y="-8" width="16" height="16" rx="3.5" /><path d="M-4.5 -5.2h9a.8 .8 0 0 1 .8 .8v7.4h-10.6v-7.4a.8 .8 0 0 1 .8-.8zM-3.6 -3.9v3.2h7.2v-3.2zM-4.6 3.4h2.4v1.8h-2.4zM2.2 3.4h2.4v1.8h-2.4z" /></>}
          </svg>
          <p><strong>{dove}</strong> {come}</p>
        </li>
      ))}
    </ul>
    <div class="mappa__riga">
      <a class="rimando" href={contatti.mapsUrl} target="_blank" rel="noopener">{L.apri}<span class="sr-only"> ({L.nuovaScheda})</span> <Freccia /></a>
      <small>{L.dati} © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a></small>
    </div>
  </figcaption>
</figure>

<style>
  .mappa { display: grid; gap: 1.6rem; margin: 0; }
  /* sul computer la mappa sta accanto alla legenda: genera-mappa.py piazza i nomi per
     un riquadro largo almeno 550 px, quello che resta qui a 1024 px di finestra */
  @media (min-width: 64rem) {
    .mappa { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); column-gap: 3rem; align-items: center; }
  }
  .mappa__quadro {
    display: block; overflow: hidden; aspect-ratio: 4 / 5;
    container: mappa / inline-size;
    border: 1px solid var(--bordo); background: var(--notte);
    transition: border-color .3s ease;
  }
  .mappa__quadro:hover, .mappa__quadro:focus-visible { border-color: rgba(194, 146, 78, .55); }
  @media (min-width: 40rem) { .mappa__quadro { aspect-ratio: 3 / 2; } }

  /* la legenda */
  .mappa__piede { display: grid; gap: 1.1rem; align-content: center; }
  .mappa__tappe { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; color: var(--travertino); }
  .mappa__tappe li { display: grid; grid-template-columns: 1.125rem minmax(0, 1fr); gap: .85rem; align-items: start; }
  .mappa__tappe p { margin: 0; max-width: 46ch; }
  .mappa__tappe strong { font-weight: 400; color: var(--oro-chiaro); margin-right: .3em; }
  .mappa__segno { width: 1.125rem; height: 1.125rem; margin-top: .2em; overflow: visible; }
  .mappa__segno--via path { stroke: var(--oro); stroke-opacity: .6; stroke-width: 3; stroke-linecap: round; fill: none; }
  .mappa__riga { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem 1.5rem; }
  .mappa__riga small { font-size: var(--fs-xs); color: var(--fumo); }
  .mappa__riga small a { color: inherit; }

  /* il disegno: le classi le scrive scripts/genera-mappa.py; dimensioni e spaziature dei
     nomi sono attributi degli SVG (lo script le usa per piazzarli), qui solo colori e font */
  .mappa__quadro :global(.carta) { display: block; width: 100%; height: 100%; }
  .mappa__quadro :global(.carta--larga) { display: none; }
  @media (min-width: 40rem) {
    .mappa__quadro :global(.carta--larga) { display: block; }
    .mappa__quadro :global(.carta--telefono) { display: none; }
  }
  .mappa :global(.fondo) { fill: var(--notte); }
  .mappa :global(.verde) { fill: var(--muschio); fill-opacity: .32; }
  .mappa :global(.strada) { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .mappa :global(.s5) { stroke: #221b14; stroke-width: 1.5; }
  .mappa :global(.s4) { stroke: #2b231a; stroke-width: 3; }
  .mappa :global(.s3) { stroke: #382e23; stroke-width: 4.5; }
  .mappa :global(.s2) { stroke: #463a2b; stroke-width: 6; }
  .mappa :global(.s1) { stroke: #564734; stroke-width: 8; }
  /* gli spessori delle evidenze sono anche in EVIDENZE dello script: i nomi le scansano */
  .mappa :global(.evidenza) { stroke: var(--oro); stroke-opacity: .6; stroke-width: 7; }
  .mappa :global(.evidenza-veneto) { stroke: var(--oro); stroke-opacity: .34; stroke-width: 8; }
  .mappa :global(.mura) { fill: none; stroke: #7a6a52; stroke-opacity: .55; stroke-width: 3; stroke-dasharray: 1 7; stroke-linecap: round; }
  .mappa :global(.nome), .mappa :global(.insegna), .mappa :global(.luogo), .mappa :global(.metro-nome), .mappa :global(.bus-linee) {
    font-family: var(--font-lapide); text-transform: uppercase;
    paint-order: stroke; stroke: var(--notte); stroke-width: 3.5px; stroke-linejoin: round;
  }
  .mappa :global(.nome) { fill: var(--fumo); }
  .mappa :global(.nome.forte) { fill: var(--oro-chiaro); }
  .mappa :global(.luogo) { fill: #9a8f7c; }
  .mappa :global(.insegna) { fill: var(--oro-chiaro); }
  .mappa :global(.metro-nome), .mappa :global(.bus-linee) { fill: var(--travertino); }
  .mappa :global(.alone) { fill: var(--oro); fill-opacity: .14; }
  .mappa :global(.anello) { fill: none; stroke: var(--oro); stroke-width: 2; }
  .mappa :global(.punto) { fill: var(--oro-chiaro); }
  /* la «M» rossa della metro di Roma, in tono con la pagina */
  .mappa :global(.metro rect), .mappa__segno--metro rect { fill: #a8352a; }
  .mappa :global(.metro-m), .mappa__segno--metro text { font-family: var(--font-ui); font-weight: 500; fill: #f3ece0; }
  .mappa__segno--metro text { font-size: 12px; }
  /* la fermata del bus: un cartello scuro col pullman chiaro */
  .mappa :global(.bus rect), .mappa__segno--bus rect { fill: var(--notte); stroke: var(--travertino); stroke-width: 1.2; }
  .mappa :global(.bus path), .mappa__segno--bus path { fill: var(--travertino); }
</style>

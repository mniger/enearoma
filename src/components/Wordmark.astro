---
/**
 * Solo le parole del marchio (ENEA + ROMA), senza il pino — per la barra
 * di navigazione, dove il lockup verticale sarebbe alto il doppio della barra.
 *
 * Tracciati UFFICIALI del designer: estratti dalla dima vettoriale di stampa
 * («Enea Roma ristorante dima 115 x 75», Illustrator, consegnata da Diego il
 * 07/09/2026), scritte già scontornate, nessun font. Tutti i componenti del
 * marchio condividono lo stesso sistema di coordinate della dima (origine
 * in alto a sinistra del lockup completo): cambia solo il viewBox di ritaglio.
 *
 * La misura si dà con --wordmark-larghezza: le custom property attraversano lo scope
 * dei componenti Astro, le classi no.
 */
interface Props { class?: string; titolo?: string }
const { class: cls, titolo } = Astro.props;

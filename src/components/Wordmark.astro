---
/**
 * Solo le parole del marchio, senza il pino — per la barra di navigazione,
 * dove il lockup verticale sarebbe alto il doppio della barra stessa.
 *
 * Vettorializzato dal render di pagina 12 del manuale (il più uniforme come
 * illuminazione) con potrace, su maschera normalizzata localmente.
 * La luce del set arriva da destra e lascia in ombra il lato sinistro della
 * chioma: quella metà è ricostruita riflettendo la metà illuminata, perché il
 * pino del marchio è simmetrico per disegno e un logo dimezzato non è un logo.
 * Quando il cliente consegna l’SVG originale si sostituisce solo questo file.
 *
 * La misura si dà con --wordmark-larghezza: le custom property attraversano lo scope
 * dei componenti Astro, le classi no.
 */
interface Props { class?: string; titolo?: string }
const { class: cls, titolo } = Astro.props;
---
<svg
  class={cls}
  viewBox="0 0 682 243"
  role={titolo ? 'img' : undefined}
  aria-hidden={titolo ? undefined : 'true'}
  aria-label={titolo}
  focusable="false"

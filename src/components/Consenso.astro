---
/**
 * Banner dei cookie. Google Ads si carica solo dopo «Accetta» (lo script è in Base.astro):
 * «Accetta» e «Rifiuta» hanno lo stesso peso, come chiede il Garante. La scelta resta nel
 * browser; «Preferenze cookie» nel piè di pagina riapre il banner.
 */
import type { Locale } from '../data/site';
const locale = (Astro.currentLocale ?? 'it') as Locale;
const L = locale === 'en'
  ? {
      testo: 'We use Google Ads cookies only if you agree, to measure how well our ads work. You can change your mind at any time from «Cookie preferences» at the bottom of the page.',
      note: 'Legal notes', href: '/en/note-legali/', si: 'Accept', no: 'Decline',
    }
  : {
      testo: 'Usiamo i cookie di Google Ads solo se acconsenti, per misurare quanto funzionano i nostri annunci. Puoi cambiare idea quando vuoi da «Preferenze cookie» in fondo alla pagina.',
      note: 'Note legali', href: '/note-legali/', si: 'Accetta', no: 'Rifiuta',
    };
---
<div class="consenso" id="consenso" role="dialog" aria-labelledby="consenso-titolo" aria-describedby="consenso-testo" hidden>
  <p class="consenso__titolo" id="consenso-titolo">Cookie</p>
  <p class="consenso__testo" id="consenso-testo">{L.testo} <a href={L.href}>{L.note}</a></p>
  <div class="consenso__scelte">
    <button type="button" class="btn" data-scelta="no">{L.no}</button>
    <button type="button" class="btn" data-scelta="si">{L.si}</button>
  </div>
</div>

<script>
  const CHIAVE = 'enea-cookie';
  const leggi = () => { try { return localStorage.getItem(CHIAVE); } catch { return null; } };
  const w = window as unknown as { eneaCaricaAds?: () => void; gtag?: (...a: unknown[]) => void };

  function scegli(valore: string) {
    const prima = leggi();
    try { localStorage.setItem(CHIAVE, valore); } catch { /* navigazione privata: si richiede alla prossima pagina */ }
    const banner = document.getElementById('consenso');
    if (banner) banner.hidden = true;
    if (valore === 'si') w.eneaCaricaAds?.();
    else if (prima === 'si') {
      // revoca: Google è già caricato, si nega il consenso e si ricarica la pagina senza di lui
      w.gtag?.('consent', 'update', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      location.reload();
    }
  }

  document.addEventListener('astro:page-load', () => {
    const banner = document.getElementById('consenso');
    if (!banner) return;
    const scelta = leggi();
    banner.hidden = scelta === 'si' || scelta === 'no';
    banner.querySelectorAll<HTMLButtonElement>('[data-scelta]').forEach((b) => { b.onclick = () => scegli(b.dataset.scelta!); });
    document.querySelectorAll<HTMLElement>('[data-preferenze-cookie]').forEach((b) => {
      b.onclick = () => { banner.hidden = false; banner.querySelector('button')?.focus(); };
    });
  });
</script>

<style>
  .consenso {
    position: fixed; z-index: 60; inset-inline: 1rem; bottom: 1rem; margin-inline: auto; max-width: 34rem;
    background: var(--notte); border: 1px solid var(--bordo); padding: 1.25rem 1.35rem;
    box-shadow: 0 18px 48px rgba(0, 0, 0, .45);
  }
  .consenso:not([hidden]) { display: grid; gap: .75rem; }
  .consenso__titolo {
    margin: 0; font-family: var(--font-lapide); font-size: var(--fs-xs); letter-spacing: .22em;
    text-transform: uppercase; color: var(--oro);
  }
  .consenso__testo { margin: 0; font-size: var(--fs-sm); color: var(--fumo); line-height: 1.6; }
  .consenso__testo a { color: var(--oro-chiaro); text-decoration: none; border-bottom: 1px solid rgba(194, 146, 78, .45); }
  .consenso__scelte { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
  .consenso__scelte .btn { padding: .85rem 1rem; background: transparent; color: var(--travertino); }
  .consenso__scelte .btn:hover, .consenso__scelte .btn:focus-visible { color: var(--pece); }
</style>

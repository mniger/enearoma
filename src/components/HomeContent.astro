---
/**
 * Home di ENEA Roma — contenuto condiviso fra IT ed EN.
 *
 * Chi arriva qui vuole sapere tre cose, in quest’ordine: che posto è, cosa si
 * mangia, dove e quando. Il sito risponde in quest’ordine e con le fotografie,
 * perché un ristorante si sceglie con gli occhi. Il testo resta il minimo
 * necessario: il manuale del brand è un documento interno per la squadra e non
 * va in vetrina.
 *
 * Le informazioni non ancora confermate dal cliente sono marcate `data-attesa`:
 * si dichiara l’assenza, non la si maschera.
 */
import { Image } from 'astro:assets';
import { brand, testi, contatti, orari, arcoGiorni, apertura, prenotazioni, piattaforme, ATTESA, type Locale } from '../data/site';
import Marchio from './Marchio.astro';
import Pino from './Pino.astro';
import Freccia from './Freccia.astro';
import MappaDove from './MappaDove.astro';
// sala-panoramica è generata con gpt-image (C2PA di OpenAI): resta in apertura per scelta di
// Marco (03/10), perché sotto il velo è la più scenica. Le foto del titolare (01/10): scatto non
// ritoccato è solo la facciata; sala-angolo, tavola e sala-verticale sono foto della sala
// ripassate con ChatGPT (1086×1448, il formato di gpt-image). Da sostituire con scatti veri.
import salaPanoramica from '../assets/foto/sala-panoramica.png';
import salaVerticale from '../assets/foto/sala-verticale.jpeg';
import facciata from '../assets/foto/facciata.jpeg';
import salaAngolo from '../assets/foto/sala-angolo.jpeg';
import tavola from '../assets/foto/tavola-apparecchiata.jpeg';

const locale = (Astro.currentLocale ?? 'it') as Locale;
const t = testi[locale];
const titoloPagina = locale === 'en' ? `${brand.nomeEsteso} — restaurant and cocktail bar` : `${brand.nomeEsteso} — ristorante e cocktail bar`;

const L = locale === 'en'
  ? {
      prenota: prenotazioni.aperte ? 'Book a table' : 'Bookings', scopri: 'The menu', scorri: 'Scroll',
      etLocale: 'The restaurant', etCucina: 'The kitchen', etBar: 'The bar',
      etDove: 'Visit us',
      tLocale: 'A dining room under brick vaults, a few steps from Via Veneto',
      pLocale: 'Vaulted ceilings, green velvet, candlelight and a wall of bottles. Roman in character, Mediterranean in spirit, open for lunch, aperitivo and dinner.',
      tCucina: 'Mediterranean cooking, Roman roots',
      pCucina: 'Seasonal ingredients and clear flavours, plated with care but never precious. The dishes are the ones you want to order again.',
      tBar: 'Come in just for a drink',
      pBar: 'The Italian aperitivo, the classic cocktails made properly, and a wine list chosen to follow the kitchen.',
      tDove: `${contatti.via}\u00a0${contatti.civico}, Rome`,
      vediMenu: 'The à la carte menu', vediPranzo: 'The business lunch', vediAperitivo: 'The aperitivo menu', vediCocktail: 'The cocktail list',
      barAttesa: 'The wine list is on its way.',
      indirizzo: 'Address', telefono: 'Phone', orariL: 'Opening hours', serviziL: 'Kitchen & bar', chiuso: 'closed', scrivi: 'Email',
      inArrivo: 'coming soon', indicazioni: 'Open in Google Maps', nuovaScheda: 'opens in a new tab',
      prenotaTitolo: 'Book a table', chiama: 'Call', suWhatsapp: 'WhatsApp', suOpentable: 'Book on OpenTable',
      comePrenotare: 'Bookings will open when the restaurant does. The telephone number and booking email will appear on this page as soon as they are live.',
      altPanoramica: 'The ENEA dining room under its brick vaults',
      altSala: 'Tables laid for the evening at ENEA',
      altIngresso: 'The ENEA entrance on Via Boncompagni at dusk: the lit sign and the open door',
      altAngolo: 'A corner of the ENEA dining room: glass-globe lamps, a painting, two laid tables',
      altTavola: 'A table laid at ENEA: leather place mat with the name, glasses and cutlery',
    }
  : {
      prenota: prenotazioni.aperte ? 'Prenota un tavolo' : 'Prenotazioni', scopri: 'Il menu', scorri: 'Scorri',
      etLocale: 'Il ristorante', etCucina: 'La cucina', etBar: 'Il bar',
      etDove: 'Dove siamo',
      tLocale: 'Una sala sotto volte di mattoni, a due passi da Via Veneto',
      pLocale: 'Soffitti a volta, velluto verde, luce di candela e una parete di bottiglie. Romano nel carattere, mediterraneo nello spirito, aperto a pranzo, all’aperitivo e a cena.',
      tCucina: 'Cucina mediterranea, radici romane',
      pCucina: 'Ingredienti di stagione e sapori netti, impiattati con cura ma senza sussiego. Piatti che viene voglia di ordinare di nuovo.',
      tBar: 'Si entra anche solo per bere',
      pBar: "L’aperitivo italiano, i cocktail classici fatti come si deve e una carta dei vini scelta per seguire la cucina.",
      tDove: `${contatti.via}\u00a0${contatti.civico}, Roma`,
      vediMenu: 'Il menu à la carte', vediPranzo: 'Il business lunch', vediAperitivo: 'Il menu dell’aperitivo', vediCocktail: 'La carta dei cocktail',
      barAttesa: 'La carta dei vini è in arrivo.',
      indirizzo: 'Indirizzo', telefono: 'Telefono', orariL: 'Orari', serviziL: 'Cucina e bar', chiuso: 'chiuso', scrivi: 'Email',
      inArrivo: 'in arrivo', indicazioni: 'Apri in Google Maps', nuovaScheda: 'si apre in una nuova scheda',
      prenotaTitolo: 'Prenota un tavolo', chiama: 'Chiama', suWhatsapp: 'WhatsApp', suOpentable: 'Prenota su OpenTable',
      comePrenotare: 'Le prenotazioni aprono insieme al ristorante. Numero di telefono ed email per prenotare compariranno qui appena saranno attivi.',
      altPanoramica: 'La sala di ENEA sotto le volte in mattoni',
      altSala: 'Tavoli apparecchiati per la sera da ENEA',
      altIngresso: "L’ingresso di ENEA su Via Boncompagni al tramonto: l’insegna illuminata e la porta aperta",
      altAngolo: 'Un angolo della sala di ENEA: lampade a sfera, un quadro, due tavoli apparecchiati',
      altTavola: 'Una tavola apparecchiata da ENEA: la tovaglietta in cuoio col nome, calici e posate',
    };

const dato = (v: string) => (v === ATTESA ? L.inArrivo : v);
// La città si localizza: su /en/ il titolo dice "Rome", l’indirizzo non può dire "Roma".
const citta = locale === 'en' ? 'Rome' : contatti.citta;
const indirizzo = `${contatti.via}\u00a0${contatti.civico}, ${contatti.cap}\u00a0${citta}`;

// Due blocchi di orari: i giorni di apertura, poi pranzo, aperitivo e cena in ordine di ora.
// I giorni di un servizio si dicono solo se non sono quelli di apertura.
const ore = (f: { apre: string; chiude: string }) => `${f.apre}–${f.chiude}`;
const aperto: readonly string[] = orari.locale.flatMap((f) => f.giorni);
const altriGiorni = (g: readonly string[]) => g.length !== aperto.length || g.some((x) => !aperto.includes(x));
const blocchiOrari: { area: string; titolo: string; righe: { quando: string; giorni?: string; ore: string; chiuso?: boolean }[] }[] = [
  {
    area: 'orari',
    titolo: L.orariL,
    righe: [
      ...orari.locale.map((f) => ({ quando: arcoGiorni(f.giorni, locale, 'riga'), ore: ore(f) })),
      { quando: arcoGiorni(orari.chiuso, locale, 'riga'), ore: L.chiuso, chiuso: true },
    ],
  },
  {
    area: 'servizi',
    titolo: L.serviziL,
    righe: orari.servizi.map((f) => ({
      quando: f.nome[locale],
      ...(altriGiorni(f.giorni) && { giorni: arcoGiorni(f.giorni, locale, 'breve') }),
      ore: ore(f),
    })),
  },
];

// Canali di prenotazione: compaiono al lancio, e solo quelli con un dato reale.
const c = (v: string) => v !== ATTESA;
const soloCifre = (v: string) => v.replace(/[^\d+]/g, '');
const canali = prenotazioni.aperte
  ? [
      c(contatti.telefono) && { href: `tel:${soloCifre(contatti.telefono)}`, testo: `${L.chiama} ${contatti.telefono}`, pieno: true },
      c(contatti.whatsapp) && { href: `https://wa.me/${soloCifre(contatti.whatsapp).replace('+', '')}`, testo: L.suWhatsapp, pieno: false },
      prenotazioni.conOpenTable && { href: piattaforme.opentablePrenota[locale], testo: L.suOpentable, pieno: false },
    ].filter((x): x is { href: string; testo: string; pieno: boolean } => Boolean(x))
  : [];
// Il pulsante pieno è l'azione possibile oggi: prenotare quando le prenotazioni
// sono aperte, altrimenti leggere il menu. Il primo dei due è sempre quello pieno.
const azioni = [
  { href: '#prenota', testo: L.prenota, pieno: prenotazioni.aperte },
  { href: locale === 'en' ? '/en/menu/' : '/menu/', testo: L.scopri, pieno: !prenotazioni.aperte },
].sort((a, b) => Number(b.pieno) - Number(a.pieno));
---

<!-- ═════════ APERTURA ═════════ -->
<section class="apertura">
  <div class="apertura__foto" data-parallasse>
    <Image src={salaPanoramica} alt={L.altPanoramica} widths={[900, 1448]} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="apertura__velo" aria-hidden="true"></div>

  <div class="wrap apertura__corpo">
    <h1 class="apertura__marchio"><Marchio completo /><span class="sr-only">{titoloPagina}</span></h1>
    <p class="apertura__claim">{t.claim}</p>
    <p class="apertura__riga">
      <a href="#dove">{indirizzo}</a><i aria-hidden="true"></i><span><span class="sr-only">— </span>{apertura.periodo[locale]}</span>
    </p>
    <div class="apertura__azioni">
      {azioni.map((a) => <a class:list={['btn', a.pieno ? 'btn--pieno' : 'btn--nudo']} href={a.href}>{a.testo}</a>)}
    </div>
  </div>
  <div class="apertura__scorri" aria-hidden="true"><span>{L.scorri}</span><i></i></div>
</section>

<!-- ═════════ IL RISTORANTE ═════════ -->
<section id="locale">
  <div class="wrap duetto">
    <figure class="quadro duetto__foto" data-reveal>
      <Image src={salaVerticale} alt={L.altSala} widths={[560, 800, 1086]} sizes="(min-width: 64rem) 46vw, 92vw" loading="lazy" />
    </figure>
    <div class="duetto__testo">
      <p class="eyebrow" data-reveal>{L.etLocale}</p>
      <h2 data-reveal data-ritardo="1">{L.tLocale}</h2>
      <p class="corpo" data-reveal data-ritardo="2">{L.pLocale}</p>
      <div class="fregio fregio--sinistra" data-reveal data-ritardo="3" aria-hidden="true"><Pino /></div>
      <p class="corpo corpo--tenue" data-reveal data-ritardo="3">{t.origine}</p>
    </div>
  </div>
</section>

<!-- ═════════ CUCINA E BAR ═════════ -->
<section id="cucina-e-bar" class="portate">
  <div class="wrap portate__griglia">
    <article class="portata">
      <figure class="quadro portata__foto" data-reveal>
        <Image src={tavola} alt={L.altTavola} widths={[480, 800, 1086]} sizes="(min-width: 58rem) 44vw, 92vw" loading="lazy" class="foto-tavola" />
      </figure>
      <p class="eyebrow" data-reveal>{L.etCucina}</p>
      <h2 data-reveal data-ritardo="1">{L.tCucina}</h2>
      <p class="corpo" data-reveal data-ritardo="2">{L.pCucina}</p>
      <div class="portata__rimandi">
        <a class="rimando" href={locale === 'en' ? '/en/menu/' : '/menu/'} data-reveal data-ritardo="3">{L.vediMenu} <Freccia /></a>
        <a class="rimando" href={locale === 'en' ? '/en/menu/lunch/' : '/menu/pranzo/'} data-reveal data-ritardo="3">{L.vediPranzo} <Freccia /></a>
      </div>
    </article>

    <article class="portata">
      <figure class="quadro portata__foto" data-reveal>
        <Image src={salaAngolo} alt={L.altAngolo} widths={[480, 800, 1086]} sizes="(min-width: 58rem) 44vw, 92vw" loading="lazy" class="foto-angolo" />
      </figure>
      <p class="eyebrow" data-reveal>{L.etBar}</p>
      <h2 data-reveal data-ritardo="1">{L.tBar}</h2>
      <p class="corpo" data-reveal data-ritardo="2">{L.pBar}</p>
      <div class="portata__rimandi">
        <a class="rimando" href={locale === 'en' ? '/en/menu/aperitivo/' : '/menu/aperitivo/'} data-reveal data-ritardo="3">{L.vediAperitivo} <Freccia /></a>
        <a class="rimando" href={locale === 'en' ? '/en/menu/cocktails/' : '/menu/cocktail/'} data-reveal data-ritardo="3">{L.vediCocktail} <Freccia /></a>
      </div>
      <p class="nota" data-reveal data-ritardo="3" data-attesa>{L.barAttesa}</p>
    </article>
  </div>
</section>

<!-- ═════════ COMMIATO ═════════ -->
<section class="commiato">
  <p class="commiato__frase" data-reveal>{t.claimApertura}</p>
</section>

<!-- ═════════ DOVE SIAMO ═════════ -->
<section id="dove">
  <div class="wrap dove">
    <div class="dove__testo">
      <p class="eyebrow" data-reveal>{L.etDove}</p>
      <h2 data-reveal data-ritardo="1">{L.tDove}</h2>
      <dl class="recapiti" data-reveal data-ritardo="2">
        <div class="recapiti__indirizzo">
          <dt>{L.indirizzo}</dt>
          <dd>{indirizzo}<br /><a class="indicazioni" href={contatti.mapsUrl} target="_blank" rel="noopener">{L.indicazioni}<span class="sr-only"> ({L.nuovaScheda})</span></a></dd>
        </div>
        {blocchiOrari.map((b) => (
          <div class={`recapiti__${b.area}`}><dt>{b.titolo}</dt><dd>
            <dl class="fasce">
              {b.righe.map((r) => (
                <div><dt>{r.quando}{r.giorni && <span class="fasce__giorni"> {r.giorni}</span>}</dt><dd class:list={[r.chiuso && 'fasce__chiuso']}>{r.ore}</dd></div>
              ))}
            </dl>
          </dd></div>
        ))}
        <div class="recapiti__telefono"><dt>{L.telefono}</dt>{c(contatti.telefono)
          ? <dd><a class="indicazioni recapito" href={`tel:${soloCifre(contatti.telefono)}`}>{contatti.telefono}</a></dd>
          : <dd data-attesa>{dato(contatti.telefono)}</dd>}</div>
        <div class="recapiti__email"><dt>{L.scrivi}</dt>{c(contatti.email)
          ? <dd><a class="indicazioni recapito" href={`mailto:${contatti.email}`}>{contatti.email}</a></dd>
          : <dd data-attesa>{dato(contatti.email)}</dd>}</div>
      </dl>
      <div id="prenota" class="prenota" tabindex="-1" data-reveal data-ritardo="3">
        <p class="eyebrow">{L.prenotaTitolo}</p>
        {canali.length > 0 ? (
          <div class="prenota-canali__azioni">
            {canali.map((k) => (
              <a class={`btn ${k.pieno ? 'btn--pieno' : 'btn--nudo'}`} href={k.href} rel="noopener">{k.testo}</a>
            ))}
          </div>
          <p class="nota">{apertura.periodo[locale]}. {apertura.dettaglio[locale]}</p>
        ) : (
          <div class="avviso">
            <p><strong>{apertura.periodo[locale]}.</strong> {apertura.dettaglio[locale]}</p>
            <p>{L.comePrenotare}</p>
          </div>
        )}
      </div>
    </div>
    <figure class="quadro dove__foto" data-reveal data-ritardo="1">
      <Image src={facciata} alt={L.altIngresso} widths={[520, 800, 1200, 1600]} sizes="(min-width: 64rem) 38vw, 92vw" loading="lazy" />
    </figure>
    <div class="dove__mappa"><MappaDove /></div>
  </div>
</section>

<style>
  section { position: relative; padding-block: var(--stack); }
  .corpo { color: var(--fumo); max-width: var(--misura); }
  .corpo--tenue { font-size: var(--fs-sm); opacity: .85; }
  .nota { font-size: var(--fs-sm); color: var(--fumo); max-width: var(--misura); }
  .rimando { justify-self: start; }

  /* ── apertura ── */
  .apertura {
    min-height: 100svh; display: grid; grid-template-rows: 1fr auto;
    gap: clamp(1.5rem, 4vh, 3rem);
    padding: calc(var(--testata-h) + clamp(.75rem, 3vh, 1.75rem)) 0 clamp(1.25rem, 2.5vh, 2rem);
    overflow: clip;   /* il parallasse muove la foto: senza questo invade la sezione dopo */
  }
  /* riserva sopra ≥ dello spostamento massimo del parallasse (14svh) */
  .apertura__foto { position: absolute; inset: -16% 0 -4%; z-index: -2; will-change: transform; }
  .apertura__foto :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: center 46%;
    filter: saturate(.95) contrast(1.03);
  }
  .apertura__velo {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(74% 58% at 50% 44%, rgba(10,8,6,.66), rgba(10,8,6,.78) 74%),
      linear-gradient(to bottom, rgba(10,8,6,.85), transparent 26%, transparent 60%, var(--pece));
  }
  .apertura__corpo {
    align-self: center; display: grid; justify-items: center; text-align: center;
  }
  .apertura__marchio {
    /* il lockup completo della dima è ~quadrato: più stretto del vecchio
       per non mangiarsi l'altezza dell'apertura */
    margin: 0; --marchio-larghezza: min(70vw, 22.5rem); color: var(--oro-luce);
    animation: emerge 1.9s var(--ease-lento) both;
  }
  @keyframes emerge { from { opacity: 0; transform: translateY(14px) scale(1.02); } to { opacity: 1; transform: none; } }
  .apertura__claim {
    font-family: var(--font-display); font-size: var(--fs-claim);
    line-height: 1.35; max-width: 24ch; color: var(--travertino);
    margin-top: 2rem;
    animation: sale 1.4s var(--ease) .85s both;
  }
  .apertura__riga {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .5rem 1.15rem;
    font-family: var(--font-lapide); font-size: var(--fs-xs); letter-spacing: .24em;
    text-transform: uppercase; color: var(--fumo);
    margin-top: 1rem;
    animation: sale 1.4s var(--ease) 1.05s both;
  }
  .apertura__riga a { color: inherit; text-decoration: none; padding-block: .5rem; transition: color .3s ease; }
  .apertura__riga a:hover { color: var(--oro-chiaro); }
  .apertura__riga i { width: 3px; height: 3px; background: var(--oro); transform: rotate(45deg); }
  @media (max-width: 40rem) {
    .apertura__riga { flex-direction: column; gap: .45rem; }
    .apertura__riga i { display: none; }
  }
  .apertura__azioni {
    display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center;
    margin-top: 2.25rem;
    animation: sale 1.4s var(--ease) 1.25s both;
  }
  /* 13. impilati sul telefono, i due pulsanti hanno la stessa larghezza */
  @media (max-width: 40rem) { .apertura__azioni .btn { min-width: 15rem; } }
  @keyframes sale { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .apertura__scorri {
    justify-self: center; display: grid; justify-items: center; gap: .7rem;
    font-family: var(--font-lapide); font-size: .5625rem; letter-spacing: .32em;
    text-transform: uppercase; color: var(--fumo);
    animation: sale 1.4s var(--ease) 1.7s both;
  }
  .apertura__scorri i {
    display: block; width: 1px; height: 48px; transform-origin: top;
    background: linear-gradient(to bottom, var(--oro), transparent);
    animation: filo 3s var(--ease) 3;
  }
  @keyframes filo { 0%, 100% { transform: scaleY(.3); opacity: .35; } 50% { transform: scaleY(1); opacity: .9; } }
  @media (max-height: 860px), (max-width: 48rem) { .apertura__scorri { display: none; } }

  /* ── il ristorante ── */
  .duetto { display: grid; gap: clamp(2.25rem, 5vw, 4.5rem); align-items: center; }
  .duetto__testo { display: grid; gap: 1.4rem; align-content: center; }
  .duetto__foto :global(img) { max-height: 78vh; object-fit: cover; }
  .fregio { display: flex; align-items: center; gap: 1.25rem; color: var(--oro); --pino-larghezza: 44px; }
  .fregio::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to right, currentColor, transparent); }
  .fregio--sinistra { width: min(280px, 68%); }
  @media (min-width: 64rem) { .duetto { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); } }

  /* ── cucina e bar ── */
  .portate__griglia { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .portata { display: grid; gap: 1.15rem; align-content: start; }
  .portata__foto { margin-bottom: .6rem; }
  .portata__rimandi { display: grid; gap: 1.15rem; }
  .portata__foto :global(img) { aspect-ratio: 4 / 3; object-fit: cover; }
  /* foto verticali nel riquadro 4:3: si tengono in vista il nome sulla tovaglietta e lampade e quadro */
  .portata__foto :global(.foto-tavola) { object-position: 50% 62%; }
  .portata__foto :global(.foto-angolo) { object-position: 50% 30%; }
  @media (min-width: 58rem) {
    /* le righe delle due schede si allineano (foto, occhiello, titolo, testo, rimandi, nota):
       sei figli per scheda, uno per riga; un figlio in più finirebbe sovrapposto all'ultimo */
    .portate__griglia { grid-template-columns: 1fr 1fr; grid-template-rows: repeat(6, auto); }
    .portata { grid-template-rows: subgrid; grid-row: span 6; }
  }

  /* ── commiato ── */
  .commiato { border-block: 1px solid var(--bordo); text-align: center; }
  .commiato__frase {
    font-family: var(--font-display); font-size: var(--fs-triade); line-height: 1.35;
    color: var(--travertino); text-wrap: balance;
    max-width: 44ch; margin-inline: auto; padding-inline: var(--gutter);
  }

  /* ── dove siamo ── */
  .dove { display: grid; gap: clamp(2.25rem, 5vw, 4rem); align-items: start; }
  .dove__testo { display: grid; gap: 1.6rem; }
  .recapiti { display: grid; gap: 1.4rem; grid-template-columns: 1fr; margin: 0; }
  .recapiti > div > dt {
    font-family: var(--font-lapide); font-size: var(--fs-xs); letter-spacing: .22em;
    text-transform: uppercase; color: var(--oro); margin-bottom: .45rem;
  }
  .recapiti dd { margin: 0; color: var(--travertino); }
  /* giorni a sinistra, ore in colonna a destra */
  .fasce { display: grid; grid-template-columns: max-content auto; gap: .2rem 1.25rem; margin: 0; }
  .fasce > div { display: grid; grid-template-columns: subgrid; grid-column: 1 / -1; }
  .fasce dt { color: var(--travertino); }
  .fasce dd { font-variant-numeric: tabular-nums; }
  .fasce__giorni { font-size: var(--fs-sm); color: var(--fumo); }
  .recapiti .fasce__chiuso { color: var(--fumo); }
  .indicazioni {
    display: inline-block; margin-top: .35rem; padding-block: .5rem;
    font-size: var(--fs-sm); color: var(--oro-chiaro);
    text-decoration: none; border-bottom: 1px solid rgba(194, 146, 78, .45);
    transition: color .3s ease, border-color .3s ease;
  }
  .indicazioni:hover { color: var(--oro-luce); border-color: var(--oro); }
  .indicazioni.recapito { font-size: var(--fs-base); color: var(--travertino); margin-top: 0; }
  .avviso {
    display: grid; gap: .7rem; max-width: 48ch; color: var(--fumo);
    padding: 1.25rem 1.4rem; border-left: 1px solid var(--oro); background: var(--notte);
  }
  .avviso strong { color: var(--travertino); font-weight: 400; }
  .prenota { display: grid; gap: .9rem; }
  .prenota:focus { outline: none; }   /* il focus è programmatico: lo SR legge, l'anello non serve */
  .prenota-canali__azioni { display: flex; flex-wrap: wrap; gap: .8rem; }
  .dove__foto :global(img) { max-height: 64vh; object-fit: cover; }
  .dove__mappa { grid-column: 1 / -1; }
  /* a due colonne: a sinistra dove e come contattarci, a destra quando */
  @media (min-width: 40rem) {
    .recapiti {
      grid-template-columns: repeat(2, 1fr);
      grid-template-areas: "indirizzo orari" "telefono servizi" "email servizi";
    }
    .recapiti__indirizzo { grid-area: indirizzo; }
    .recapiti__orari { grid-area: orari; }
    .recapiti__servizi { grid-area: servizi; }
    .recapiti__telefono { grid-area: telefono; }
    .recapiti__email { grid-area: email; }
  }
  @media (min-width: 64rem) { .dove { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); } }

  @media (prefers-reduced-motion: reduce) {
    .apertura__marchio, .apertura__claim, .apertura__riga,
    .apertura__azioni, .apertura__scorri { animation: none; }
    .apertura__scorri i { animation: none; transform: scaleY(1); }
    .apertura__foto { inset: 0; }
  }
</style>

<script>
  /* Parallasse tenue sulla fotografia d’apertura: una sola proprietà animata, in rAF. */
  let stacca: (() => void) | null = null;

  function avvia() {
    stacca?.();
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const foto = document.querySelector<HTMLElement>('[data-parallasse]');
    if (!foto) return;
    let atteso = false;
    const muovi = () => {
      const y = Math.min(scrollY, innerHeight);
      foto.style.transform = `translate3d(0, ${y * 0.14}px, 0)`;
      atteso = false;
    };
    const alloScroll = () => { if (!atteso) { atteso = true; requestAnimationFrame(muovi); } };
    addEventListener('scroll', alloScroll, { passive: true });
    stacca = () => removeEventListener('scroll', alloScroll);
    muovi();
  }

  document.addEventListener('astro:page-load', avvia);
</script>
